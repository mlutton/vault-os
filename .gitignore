# working directories used by driver-orchestrated agent runs — never committed
.dispatch/
.reference/

# web dependencies, generated output, and local environment
/web/node_modules/
/web/.next/
/web/out/
/web/*.tsbuildinfo
/web/.env*
!/web/.env.example

# Python bytecode -- never tracked; running any gate regenerates it, and a
# dirty tree blocks the next parcel dispatch.
__pycache__/
*.py[cod]

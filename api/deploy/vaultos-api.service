[Unit]
Description=Vault-Os-Api backend spine
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
WorkingDirectory=/path/to/Vault-Os-Api
EnvironmentFile=%h/.config/vaultos-api/env
ExecStart=/path/to/Vault-Os-Api/.venv/bin/uvicorn vaultos.main:app --host 0.0.0.0 --port 3109
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target

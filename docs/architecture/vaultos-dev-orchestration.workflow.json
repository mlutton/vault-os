{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "VaultOS Dev Orchestration",
    "output": "vaultos-dev-orchestration.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "full-cycle",
        "label": "One build cycle",
        "focus": ["ticket", "claim", "build", "triage", "pr", "val", "merge", "close"],
        "note": "A ticket from the frontier to a merged PR and a mirrored decision record."
      },
      {
        "id": "ladder",
        "label": "The verification ladder",
        "focus": ["triage", "pr", "val"],
        "note": "Cheapest layer first: deterministic CI, then a cheap-model smoke pass, then the full independent audit."
      },
      {
        "id": "two-trackers",
        "label": "Two trackers, two jobs",
        "focus": ["ticket", "claim", "pr", "merge", "close"],
        "note": "Candid orchestration stays private; the public repo carries only curated evidence. Links run private to public, never back."
      }
    ]
  },
  "lanes": [
    { "id": "private", "label": "Private orchestration" },
    { "id": "exec", "label": "Executor lane" },
    { "id": "verify", "label": "Verification agents", "variant": "exception" },
    { "id": "public", "label": "Public repo" }
  ],
  "phases": [
    { "id": "dispatch", "label": "Dispatch", "fromCol": 0, "toCol": 1 },
    { "id": "buildphase", "label": "Build", "fromCol": 2, "toCol": 2 },
    { "id": "verifyphase", "label": "Verify", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "land", "label": "Land", "fromCol": 5, "toCol": 5 }
  ],
  "groups": [
    {
      "id": "curated",
      "label": "Outsider-safe surface",
      "lane": "public",
      "fromCol": 4,
      "toCol": 5,
      "variant": "security"
    }
  ],
  "mainPath": ["ticket", "claim", "build", "triage", "pr", "val", "merge", "close"],

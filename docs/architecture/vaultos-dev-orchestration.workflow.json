  "cards": [
    {
      "dot": "cyan",
      "title": "Two trackers, two jobs",
      "items": [
        "Orchestration stays on a private tracker — candid by construction",
        "The public repo gets curated evidence; links run private → public only"
      ]
    },
    {
      "dot": "violet",
      "title": "The verification ladder",
      "items": [
        "Deterministic CI first: tests · scrub · PR shape — never LLM-checked",
        "Cheap-model triage bounces bad handbacks; VAL audits what CI can't"
      ]
    },
    {
      "dot": "rose",
      "title": "Human holds the merge",
      "items": [
        "The operator reviews the criteria→proof table and merges — agents never",
        "Every receipt names the exact model that did the work"
      ]
    }
  ]

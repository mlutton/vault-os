  "cards": [
    {
      "dot": "cyan",
      "title": "Service-canonical",
      "items": [
        "The database owns job state; surfaces only submit and read",
        "The registry validates skill + args at the door \u2014 a stale registry rejects loudly, not silently"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust the check, not the worker",
      "items": [
        "A worker's own success claim is ignored \u2014 the check command's exit code decides",
        "One retry, with the failure context appended to the prompt"
      ]
    },
    {
      "dot": "violet",
      "title": "Every attempt is data",
      "items": [
        "Each attempt emits an eval event: engine, model, duration, outcome",
        "Engine routing improves from measurements, not vibes"
      ]
    }
  ]

#!/usr/bin/env bash
set -uo pipefail

repo_root="${1:?repository root is required}"
source "$repo_root/scripts/preflight/hermetic-env.sh"

if command -v npm >/dev/null 2>&1; then
  npm_command=(npm)
elif command -v corepack >/dev/null 2>&1; then
  npm_command=(corepack npm)
else
  echo "FAIL web — npm is not installed"
  exit 1
fi

# Dependencies must be installed before any check can mean anything. Without
# this guard the first check fails with a bare "tsc: not found", which reads as
# a type error rather than a setup step -- and preflight is every parcel's
# baseline, so the message has to be actionable on a fresh clone.
if [ ! -d "$repo_root/web/node_modules" ]; then
  echo "FAIL web — dependencies not installed; run: npm ci --prefix web"
  exit 1
fi

for check in typecheck lint test build; do
  if ! "${npm_command[@]}" --prefix "$repo_root/web" run "$check"; then
    echo "FAIL web — $check"
    exit 1
  fi
done

echo "PASS web — typecheck, lint, test, build"
